# Copie para backend/.env e preencha. O .env é ignorado pelo git — nunca o commite.

# Obrigatório. Supabase > Connect > Session pooler (porta 5432), com a senha do banco.
# Senha perdida? Project Settings > Database > Reset database password (não afeta a chave anon do bot).
DATABASE_URL=postgresql://postgres.khkeojieopvuwbiizkom:<SENHA>@aws-0-us-east-1.pooler.supabase.com:5432/postgres

# Schema onde ficam as tabelas do Taylor (o public é do bot_estoque).
DB_SCHEMA=taylor

# Gerado automaticamente por `python setup_db.py` se ficar vazio.
JWT_SECRET=
JWT_EXPIRA_MINUTOS=720
JWT_EXPIRA_LEMBRAR_DIAS=30

# HTTP
CORS_ORIGINS=*
SERVIR_FRONT=true

# Sem token, as rotas usam a empresa deste CNPJ (protótipo de voz e testes rápidos).
# Use false quando o sistema sair do ambiente local.
DEMO_MODE=true
DEMO_CNPJ=12345678000195

# Esqueci minha senha. Endereço usado no link enviado por e-mail.
APP_URL=http://localhost:8000
REDEFINICAO_MINUTOS=30
# E-mail (SMTP). Sem SMTP_HOST, o link vai para o log do servidor e, com DEMO_MODE=true,
# aparece na própria tela de login. Gmail: smtp.gmail.com, porta 587, com "senha de app".
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Gemini (opcional; sem chave o assistente usa palavras-chave)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Simuladores
SEFAZ_TAXA_REJEICAO=0.1
SEFAZ_SEGUNDOS_PROCESSAMENTO=2
SIMULADOR_TAXA_DIVERGENCIA=0.3
SIMULADOR_MAX_PEDIDOS_POR_CANAL=3
