# Copie para backend/.env e preencha. O .env é ignorado pelo git — nunca o commite.

# Obrigatório. Supabase > Connect > Session pooler (porta 5432), com a senha do banco.
# Senha perdida? Project Settings > Database > Reset database password (não afeta a chave anon do bot).
DATABASE_URL=postgresql://postgres.khkeojieopvuwbiizkom:<SENHA>@aws-0-us-east-1.pooler.supabase.com:5432/postgres

# Schema onde ficam as tabelas do Taylor (o public é do bot_estoque).
DB_SCHEMA=taylor

# Conexões com o banco por worker. No Session pooler cada conexão ocupa uma vaga do Pool Size
# (Supabase > Database > Settings > Connection pooling). A soma precisa caber nele:
#   WEB_CONCURRENCY (workers do uvicorn) x DB_POOL_MAX + DB_POOL_MAX do bot_estoque <= Pool Size
# Ex.: 2 workers x 5 + 3 do bot = 13 (Pool Size 15).
DB_POOL_MIN=1
DB_POOL_MAX=5

# Localmente (DEMO_MODE=true) é gerado por `python setup_db.py` se ficar vazio.
# Em produção (DEMO_MODE=false) é obrigatório e deve ser o mesmo em todos os workers.
JWT_SECRET=
JWT_EXPIRA_MINUTOS=720
JWT_EXPIRA_LEMBRAR_DIAS=30

# HTTP
CORS_ORIGINS=*
SERVIR_FRONT=true

# Sem token, as rotas usam a empresa deste CNPJ (protótipo de voz e testes rápidos).
# Use false quando o sistema sair do ambiente local.
DEMO_MODE=true
DEMO_CNPJ=12345678000195

# Conta Demo (botão "Entrar com a conta Demo" na tela de login): cada clique cria uma loja
# isolada com os dados de exemplo. É apagada depois de CONTA_DEMO_HORAS; no máximo
# CONTA_DEMO_MAX contas ao mesmo tempo (0 desliga o botão). Cada conta ocupa ~1 MB no banco.
CONTA_DEMO_HORAS=6
CONTA_DEMO_MAX=200

# Esqueci minha senha. Endereço usado no link enviado por e-mail.
# No Render, sem a variável APP_URL, vale o endereço público do serviço (RENDER_EXTERNAL_URL).
APP_URL=http://localhost:8000
REDEFINICAO_MINUTOS=30
# E-mail (SMTP). Sem SMTP_HOST, o link vai para o log do servidor e, com DEMO_MODE=true,
# aparece na própria tela de login. Gmail: smtp.gmail.com, porta 587, com "senha de app".
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Gemini (opcional; sem chave o assistente usa palavras-chave)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Simuladores
SEFAZ_TAXA_REJEICAO=0.1
SEFAZ_SEGUNDOS_PROCESSAMENTO=2
SIMULADOR_TAXA_DIVERGENCIA=0.3
SIMULADOR_MAX_PEDIDOS_POR_CANAL=3
