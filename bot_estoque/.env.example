# Copie para bot_estoque/.env e preencha. O .env é ignorado pelo git — nunca o commite.

# Token do bot (BotFather). O bot do painel é o @EstoqueLojas_bot (CONFIG.telegram no javascript.js).
# Só pode haver UMA cópia ligada por token: se o bot já roda no Render, não ligue outra no seu computador.
TELEGRAM_TOKEN=

# A mesma DATABASE_URL do backend/.env (Supabase > Connect > Session pooler, porta 5432).
DATABASE_URL=
DB_SCHEMA=taylor

# Conexões do bot com o banco. Somam com as do backend no Pool Size do Supabase:
#   WEB_CONCURRENCY x DB_POOL_MAX (backend) + DB_POOL_MAX (bot) <= Pool Size
DB_POOL_MAX=3

# Porta do servidor HTTP que responde "Bot Online!" (o Render usa para saber que o serviço está de pé).
PORT=3001
